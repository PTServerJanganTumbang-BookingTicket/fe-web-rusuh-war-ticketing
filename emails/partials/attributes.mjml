<!-- Klien email tidak mendukung variabel CSS, jadi nilai token Signal DS (src/components/ui/signal.css) ditulis langsung. -->
<mj-attributes>
  <mj-all font-family="Poppins, Helvetica, Arial, sans-serif" />
  <mj-body background-color="#f6f3f3" width="600px" />
  <mj-section background-color="#ffffff" padding="0 24px" />
  <mj-column padding="0" />
  <mj-text color="#001a41" font-size="16px" line-height="24px" padding="0 0 16px" />
  <mj-button
    background-color="#ed0226"
    border-radius="12px"
    color="#ffffff"
    font-size="16px"
    font-weight="600"
    inner-padding="14px 24px"
    padding="8px 0 24px"
    width="100%"
  />
  <mj-divider border-color="#e4e7ec" border-width="1px" padding="8px 0 24px" />
  <mj-class name="heading" font-size="24px" font-weight="700" line-height="32px" />
  <mj-class name="muted" color="#4e5784" font-size="14px" line-height="20px" />
  <mj-class name="label" color="#4e5784" font-size="12px" line-height="16px" padding="0 0 2px" />
  <mj-class name="value" font-size="14px" font-weight="600" line-height="20px" padding="0 0 12px" />
</mj-attributes>
