<mj-section background-color="#001a41" padding="20px 24px">
  <mj-column>
    <!-- logoUrl: URL gambar PNG yang bisa diakses publik (klien email memblokir data: URI dan SVG). -->
    <mj-image
      src="{{logoUrl}}"
      alt="Rusuh Booking Tiket"
      href="{{appUrl}}"
      width="160px"
      align="left"
      padding="0"
    />
  </mj-column>
</mj-section>
