<mj-section padding="24px 0 0" background-color="transparent">
  <mj-column />
</mj-section>
<mj-section border-top="4px solid #ff0025" border-radius="16px 16px 0 0" padding="36px 40px 24px">
  <mj-column>
    <!-- logoUrl: URL gambar PNG yang bisa diakses publik (klien email memblokir data: URI dan SVG). -->
    <mj-image
      src="{{logoUrl}}"
      alt="Rusuh Booking Tiket"
      href="{{appUrl}}"
      width="160px"
      align="left"
      padding="0"
    />
  </mj-column>
</mj-section>
