# Isi dengan URL backend (produksi: https://api.rush-my-ticket.my.id). Hapus NEXT_PUBLIC_API_MOCKING untuk memakai
# backend asli.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_MOCKING=
# "include" (default, cookie queue_token sesuai kontrak) atau "omit" untuk backend lintas origin yang menjawab
# Access-Control-Allow-Origin: * (gateway uji dan api.rush-my-ticket.my.id): token antrian dikirim lewat header
# X-Queue-Token. Produksi memakai "omit".
NEXT_PUBLIC_API_CREDENTIALS=
# "queue" (default) atau "screen". Lihat useBookingViewModel.
NEXT_PUBLIC_BOOKING_EXPIRY=
